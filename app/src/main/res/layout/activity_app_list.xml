<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <Button
            android:id="@+id/btn_back"
            style="@style/Widget.Uestcit.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/app_manage_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_refresh_apps"
            style="@style/Widget.Uestcit.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/refresh" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 搜索：按应用名或包名过滤 -->
    <EditText
        android:id="@+id/edit_app_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="24dp"
        android:background="@color/panel"
        android:hint="@string/app_manage_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="10dp"
        android:paddingRight="24dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_filter_all"
            style="@style/Widget.Uestcit.Button.Accent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="72dp"
            android:text="@string/app_filter_all"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_filter_third"
            style="@style/Widget.Uestcit.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:minWidth="72dp"
            android:text="@string/app_filter_third"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_filter_disabled"
            style="@style/Widget.Uestcit.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:minWidth="72dp"
            android:text="@string/app_filter_disabled"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_app_list_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
